# Contract Autopsy Agent Environment Configuration
# Copy this file to .env and configure your values.
# NEVER commit .env to version control.

# Google Gemini API Key (get from Google AI Studio: https://aistudio.google.com/)
# Required for AI-powered plain-language summaries and AI verdict rewrites.
GEMINI_API_KEY=

# Primary Gemini Model (configurable, never hardcoded)
GEMINI_MODEL=gemini-2.5-flash

# Optional secondary provider for rate-limit insurance (Groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# App Configuration
APP_ENV=development

